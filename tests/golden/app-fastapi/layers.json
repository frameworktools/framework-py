      "layer": {
        "git": {
          "gitignore_content": "# Private data and credentials\n**/private/**\n**/*_private/**\n.env\n.env.*\n!.env.example\n.Renviron\n**/credentials/**\n**/secrets/**\n\n# Local records and caches\nframework.db\nframework.db-wal\nframework.db-shm\n.DS_Store\n\n# Python environments and caches\n.venv/\n__pycache__/\n.pytest_cache/\nrsconnect-python/\n"
        },
        "type": "fastapi",
        "files": {
          "README.md": {
            "content": "# {{project_name}}\n\nAn API built with FastAPI. The endpoints are in app/main.py. The docs are at /docs once it runs.\n\nRun it:\n\n```\nuvicorn app.main:app --reload\n```\n",
            "template": true
          },
          "app/main.py": {
            "content": "from fastapi import FastAPI\nfrom pydantic import BaseModel\n\napp = FastAPI(title=\"{{project_name}}\")\n\n\nclass Message(BaseModel):\n    message: str\n\n\n@app.get(\"/health\")\ndef health() -> dict[str, str]:\n    return {\"status\": \"ok\"}\n\n\n@app.post(\"/echo\")\ndef echo(body: Message) -> Message:\n    return body\n",
            "template": true
          },
          "conftest.py": {
            "content": "# Here so pytest puts the project folder on the import path, and tests can import app.main\n"
          },
          "app/__init__.py": {
            "content": ""
          },
          "tests/test_main.py": {
            "content": "from fastapi.testclient import TestClient\n\nfrom app.main import app\n\nclient = TestClient(app)\n\n\ndef test_health():\n    assert client.get(\"/health\").json() == {\"status\": \"ok\"}\n\n\ndef test_echo():\n    assert client.post(\"/echo\", json={\"message\": \"hi\"}).json() == {\"message\": \"hi\"}\n"
          }
        },
        "directories": {
          "app": "app",
          "data": "data",
          "tests": "tests",
          "scripts": "scripts"
        },
        "render_dirs": {},
        "settings_layout": "flat"
