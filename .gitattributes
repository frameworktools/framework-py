# Shared files and fixtures are compared by hash, so git must never change
# their line endings (Windows checkouts convert text files by default).
src/framework/_assets/** -text
tests/shared/** -text
tests/fixtures/** -text
tests/integration/compose.yml -text
tests/integration/*/init.sql -text
docs/docs-site.md -text

# Canonical skill hashes include exact file bytes.
src/framework/templates/skills/** text eol=lf
